<Window x:Class="TimeTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="640"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F9FAFB"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock Text="{Binding ErrorText}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="96" Height="36" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
        <Button Content="Save" Width="96" Height="36" Style="{StaticResource PrimaryAction}" Click="Save_Click" IsDefault="True"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel x:Name="GeneralSettings">
        <TextBlock Text="Session length (minutes)" Style="{StaticResource FieldLabel}"/>
        <TextBox Style="{StaticResource Field}" Text="{Binding SessionLengthText, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="The next session uses this length. A session already running keeps the length it started with."
                   Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>

        <TextBlock Text="Reason threshold (minutes)" Style="{StaticResource FieldLabel}"/>
        <TextBox Style="{StaticResource Field}" Text="{Binding ReasonThresholdText, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Resume asks why you stopped only when the stop is longer than this. Use 0 to ask after every stop."
                   Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>

        <TextBlock Text="Daily goal (hours)" Style="{StaticResource FieldLabel}"/>
        <TextBox Style="{StaticResource Field}" Text="{Binding DailyGoalText, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="The overall day target shown in the center of the progress ring."
                   Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>

        <TextBlock Text="Data folder" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse" Width="88" Height="36" Margin="8,0,0,0" Click="Browse_Click"/>
          <TextBox Style="{StaticResource Field}" Text="{Binding DataFolder, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
        </DockPanel>
        </StackPanel>

        <StackPanel x:Name="ProjectSettings" Margin="0,18,0,0">
        <TextBlock Text="Projects" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Leave a project's goal empty to count it only against the daily goal. At least one project stays."
                   Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <ItemsControl ItemsSource="{Binding Projects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="88"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <Button Width="28" Height="28" Click="Swatch_Click" ToolTip="Choose a color" Background="Transparent" BorderThickness="0">
                  <Ellipse Width="18" Height="18" Fill="{Binding Color, Converter={StaticResource HexBrush}}" Stroke="#D1D5DB"/>
                </Button>
                <TextBox Grid.Column="1" Style="{StaticResource Field}" Margin="0,0,8,0"
                         Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hex color"/>
                <TextBox Grid.Column="2" Style="{StaticResource Field}" Margin="0,0,8,0"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Project name"/>
                <TextBox Grid.Column="3" Style="{StaticResource Field}" Margin="0,0,8,0"
                         Text="{Binding GoalText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Daily goal in hours, or empty"/>
                <Button Grid.Column="4" Content="Remove" Height="36" Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Add project" HorizontalAlignment="Left" Height="36" Padding="12,0" Margin="0,4,0,0"
                Command="{Binding AddProjectCommand}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
