<Window
    x:Class="TimeTracker.Views.SettingsWindow"
    x:Name="SettingsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
  <Grid x:Name="Root" Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <StackPanel x:Name="GeneralSettings" Spacing="8">
          <TextBlock Text="Session length (minutes)" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
          <TextBox Text="{Binding SessionLengthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="The next session uses this length. A session already running keeps the length it started with."
                     Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>

          <TextBlock Text="Reason threshold (minutes)" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
          <TextBox Text="{Binding ReasonThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Resume and session end ask why you stopped only when the stop is longer than this. Changing project brings elapsed time without asking when focused time is not longer than this. Use 0 to ask after every stop."
                     Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>

          <TextBlock Text="Daily goal (hours)" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
          <TextBox Text="{Binding DailyGoalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="The overall day target shown in the center of the progress ring."
                     Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>

          <TextBlock Text="Data folder" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding DataFolder, Mode=TwoWay}" IsReadOnly="True"/>
            <Button Grid.Column="1" Content="Browse" Click="Browse_Click"/>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="ProjectSettings" Spacing="8" Margin="0,18,0,0">
          <TextBlock Text="Projects" Style="{ThemeResource SubtitleTextBlockStyle}"/>
          <TextBlock Text="Leave a project's goal empty to count it only against the daily goal. At least one project stays."
                     Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>

          <ItemsControl ItemsSource="{Binding Projects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button Click="Swatch_Click" ToolTipService.ToolTip="Choose a color" MinWidth="32">
                    <Ellipse Width="18" Height="18" Fill="{Binding Color, Converter={StaticResource HexBrush}}"/>
                  </Button>
                  <TextBox Grid.Column="1"
                           Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="Hex color"/>
                  <TextBox Grid.Column="2"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="Project name"/>
                  <TextBox Grid.Column="3"
                           Text="{Binding GoalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="Daily goal in hours, or empty"/>
                  <Button Grid.Column="4" Content="Remove"
                          Command="{Binding DataContext.RemoveProjectCommand, ElementName=Root}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Add project" HorizontalAlignment="Left"
                  Command="{Binding AddProjectCommand}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="8">
      <TextBlock Text="{Binding ErrorText}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" Click="Cancel_Click"/>
        <Button Content="Save" Style="{ThemeResource AccentButtonStyle}" Click="Save_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>